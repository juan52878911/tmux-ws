# ws en zsh: shims primero en el PATH y registro automático de repos al hacer cd.
export PATH="$HOME/.local/share/ws/shims:$PATH"
# PATH propio de la organización (`path` en ws.toml): lo pone tmux en sus sesiones
[[ -n $WS_PATH ]] && export PATH="$WS_PATH:$PATH"
autoload -Uz add-zsh-hook
_ws_descubrir() { [[ -e .git ]] && (ws descubrir "$PWD" >/dev/null 2>&1 &) }
add-zsh-hook chpwd _ws_descubrir
